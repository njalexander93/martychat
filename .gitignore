# Ignore Python virtual environments
venv/
.env
.env.local
.env*
*.pyc
*.pyo
*.pyd
__pycache__/
*.sqlite3

# Ignore FastAPI dependencies and cache
*.log
*.db
instance/
.cache/
*.egg-info/

# Ignore Jupyter notebook checkpoints
.ipynb_checkpoints/

# Ignore VS Code settings and other IDE files
.vscode/
.idea/
*.swp
.DS_Store

# Ignore Next.js build and dependency files
frontend/.next/
frontend/node_modules/
frontend/.eslintcache

# Ignore frontend dependencies
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Ignore testing coverage reports
coverage/
.coverage
htmlcov/

# Ignore Next.js output and build
out/
build/

# Ignore production artifacts
frontend/.env.local
frontend/.env*
.vercel

# Ignore debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Ignore TypeScript build info
*.tsbuildinfo
next-env.d.ts

# Ignore Docker-related files (if you add Docker later)
docker-compose.yml
.Dockerfile
docker/

# Ignore misc files
*.pem
